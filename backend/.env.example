SECRET_KEY=replace_with_a_random_secret_key
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=travel_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Set the SSL mode required by your PostgreSQL provider, e.g. verify-full.
# POSTGRES_SSLMODE=verify-full

GEOAPIFY_API_KEY=your_geoapify_key
APP_BASE_URL=http://127.0.0.1:8000
# Resend is required for verification and password-reset emails (no console fallback).
RESEND_API_KEY=
# resend.dev can only send to the email address of your Resend account.
# For other recipients, use an address on your verified Resend domain.
RESEND_FROM_EMAIL=Travel Planner <onboarding@resend.dev>
