SECRET_KEY=replace_with_a_random_secret_key
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=travel_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Set the SSL mode required by your PostgreSQL provider, e.g. verify-full.
# POSTGRES_SSLMODE=verify-full

GEOAPIFY_API_KEY=your_geoapify_key
APP_BASE_URL=http://127.0.0.1:8000
# MailerSend is required for verification and password-reset emails (no console fallback).
MAILERSEND_API_KEY=
# Use an address on your verified MailerSend domain (or your assigned trial domain).
MAILERSEND_FROM_EMAIL=Travel Planner <verify@your-domain.com>
